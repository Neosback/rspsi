    classDef frontend fill:#95E1D3,stroke:#087F5B,color:#000
    class Frontend frontend
    class Shell,Contributions,Runtime shell
    class Features,Height,Paint,Objects,Collision,Assets plugin
    class Core,Scene,Store core
